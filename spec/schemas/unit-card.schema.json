{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/49g-holding/49GAION-protocol/spec/schemas/unit-card.schema.json",
  "title": "49GAION Operating Protocol - unit card (AIOC or HOAC)",
  "description": "The card of one unit, AIOC or HOAC, at any depth (Standard §1.7, §4.1 item 7). For an AIOC it is a section of the AIOC's blueprint file (49GAION-aioc template §1). It declares the unit's code, its kind, its parent, its inner units, what it receives and delivers, and, for an AIOC, how it is woken. A composite unit is one unit from outside: one card, its ports and its stop door. Aligned in vocabulary with the A2A Agent Card (Protocol §12). The Type is a card field, never part of the code.",
  "type": "object",
  "required": [
    "unit_kind",
    "code",
    "parent",
    "type",
    "full_name",
    "card_version",
    "version",
    "lineage",
    "lifecycle_state"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "unit_kind": {
            "const": "AIOC"
          }
        },
        "required": [
          "unit_kind"
        ]
      },
      "then": {
        "required": [
          "blueprint_version",
          "template_version",
          "input_door",
          "wake",
          "receives",
          "delivers",
          "skills",
          "configuration"
        ],
        "properties": {
          "code": {
            "pattern": "^(\\[ORG\\]|[0-9A-Za-z]+)AIOC-[A-Z]{2,5}(-[A-Z]{2,5})?$"
          },
          "type": {
            "enum": [
              "foundational",
              "structural",
              "specialised",
              "connector",
              "other"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "unit_kind": {
            "const": "HOAC"
          }
        },
        "required": [
          "unit_kind"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "pattern": "^(\\[ORG\\]|[0-9A-Za-z]+)HOAC-(GOV|TM|ACS)(-[A-Z]{2,5})?$"
          },
          "type": {
            "enum": [
              "GOV",
              "TM",
              "ACS"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "other"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "type_description"
        ]
      }
    }
  ],
  "properties": {
    "unit_kind": {
      "enum": [
        "AIOC",
        "HOAC"
      ],
      "description": "The kind of unit. Neither kind ranks above the other by its kind (Standard §1.1)."
    },
    "code": {
      "type": "string",
      "description": "The unit's one fixed code, never changed when the unit moves (Naming Standard R14). An AIOC: [ORG]AIOC-[INITIALS], for example [ORG]AIOC-SL or TenAIOC-SL. A HOAC: [ORG]HOAC-<TYPE>, for example [ORG]HOAC-TM, TenHOAC-GOV or [ORG]HOAC-ACS-SL.",
      "pattern": "^(\\[ORG\\]|[0-9A-Za-z]+)(AIOC-[A-Z]{2,5}|HOAC-(GOV|TM|ACS))(-[A-Z]{2,5})?$"
    },
    "parent": {
      "type": "string",
      "description": "The code of the unit that holds this one, or 'none' at the top of the organisation (Standard §1.7, item 2; Naming Standard R14). A change of parent needs the approval of the human seat over the unit; OCO cannot make it alone.",
      "pattern": "^(none|(\\[ORG\\]|[0-9A-Za-z]+)(AIOC-[A-Z]{2,5}|HOAC-(GOV|TM|ACS))(-[A-Z]{2,5})?)$"
    },
    "inner_units": {
      "type": "array",
      "description": "The codes of the units this unit holds directly, of either kind, listed by link, never by copy (Standard §1.7, item 7). Each inner unit has its own card whose parent is this unit's code. Empty or absent for a unit that holds none.",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(\\[ORG\\]|[0-9A-Za-z]+)(AIOC-[A-Z]{2,5}|HOAC-(GOV|TM|ACS))(-[A-Z]{2,5})?$"
      }
    },
    "ports": {
      "type": "array",
      "description": "The unit's Port cards: one input and one output of each kind (AI and HU), plus the stop door (Standard §6.1).",
      "items": {
        "$ref": "port-card.schema.json"
      }
    },
    "type": {
      "type": "string",
      "description": "For an AIOC, the AIOC Type: why the AIOC exists (49GAION-aioc docs/WHAT-IS-AN-AIOC.md §4): foundational, structural, specialised, connector, or other (described in type_description). For a HOAC, the HOAC type: GOV, TM or ACS (Standard §4.1). Panel is not a type; the AION Builder is a 49GAION capability, not an AIOC type."
    },
    "org_aion": {
      "type": "string",
      "description": "The [ORG]AION this AIOC belongs to, written with the organisation's brand prefix (for example TenAION).",
      "pattern": "^.+AION$"
    },
    "type_description": {
      "type": "string",
      "description": "Required when type is 'other': the name of the added type, why AIOCs of that type exist, and the Standard change that added it (the list of types is open)."
    },
    "full_name": {
      "type": "string",
      "description": "Full name written beside the code once, for example Organization Core Office."
    },
    "organisation": {
      "type": "string",
      "description": "The organisation whose core this is, for example Ten."
    },
    "card_version": {
      "type": "string",
      "pattern": "^v[0-9]+(\\.[0-9]+\\.[0-9]+)?(-rc[0-9]+)?$"
    },
    "blueprint_version": {
      "type": "string",
      "pattern": "^v[0-9]+(\\.[0-9]+\\.[0-9]+)?(-rc[0-9]+)?$"
    },
    "template_version": {
      "type": "string",
      "description": "The version of the 49GAION AIOC Blueprint Template this blueprint was filled from.",
      "pattern": "^v[0-9]+(\\.[0-9]+\\.[0-9]+)?(-rc[0-9]+)?$"
    },
    "mother_blueprint": {
      "type": "object",
      "description": "The versioned default blueprint in 49GAION this AIOC customised, if one exists.",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "location": {
          "type": "string"
        }
      }
    },
    "input_door": {
      "type": "string",
      "description": "Always the capability named 'Chief of Staff' in this AIOC's blueprint: the AIOC's voice to its HOAC seat. Input arrives only through the typed ports and the Input socket; HU ports, including the stop door, never pass through an AI. Capability names are plain English, with no code and no [ORG]AIOC prefix; the AIOC is given by the 'aioc' field.",
      "const": "Chief of Staff"
    },
    "wake": {
      "type": "object",
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "queue"
          ],
          "description": "The AIOC's runtime is woken from its queue."
        },
        "poll_interval_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "verified": {
          "type": "boolean",
          "description": "true only when the wake method has passed the cross-AIOC test case 8."
        }
      }
    },
    "receives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workKind"
      }
    },
    "delivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "format"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "usual_receivers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "anatomy": {
      "type": "object",
      "description": "The three layers of every AIOC and its delivery path: Panel (the only human surface, with a Health section), Back office (the AI workspace; hosts the Chief of Staff and the Office; carries protocol traffic), Versioned Definition (from which both are built and rebuilt).",
      "required": [
        "panel",
        "back_office",
        "definition",
        "delivery"
      ],
      "additionalProperties": false,
      "properties": {
        "panel": {
          "type": "object",
          "required": [
            "health"
          ],
          "properties": {
            "health": {
              "type": "object",
              "required": [
                "tests",
                "metrics"
              ],
              "properties": {
                "tests": {
                  "type": "boolean",
                  "description": "true when the Health section shows the fixed-test results."
                },
                "metrics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Simple metrics shown, at least stuck, returned and late items.",
                  "allOf": [
                    {
                      "contains": {
                        "const": "stuck"
                      }
                    },
                    {
                      "contains": {
                        "const": "returned"
                      }
                    },
                    {
                      "contains": {
                        "const": "late"
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "back_office": {
          "type": "object",
          "properties": {
            "converses_with_humans": {
              "type": "boolean"
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Capabilities that live in the Back office, for example Chief of Staff, Office."
            },
            "protocol_traffic": {
              "const": true,
              "description": "Protocol traffic between AIOCs goes through the Back office."
            }
          }
        },
        "definition": {
          "type": "object",
          "required": [
            "location",
            "version"
          ],
          "properties": {
            "location": {
              "type": "string",
              "description": "Repository and path of the Versioned Definition (the blueprint)."
            },
            "version": {
              "type": "string",
              "description": "Commit or version the Panel and the Back office were built from."
            }
          }
        },
        "delivery": {
          "type": "object",
          "required": [
            "rollback"
          ],
          "properties": {
            "rollback": {
              "const": "one-click",
              "description": "Delivery path: definition change, tests, Panel and Back office update, one-click rollback."
            }
          }
        },
        "connectors": {
          "type": "array",
          "description": "Swappable connectors, one per tool role; access managed in the Panel. Tool names belong to an [ORG]AION, never to the Standard.",
          "items": {
            "type": "object",
            "required": [
              "role",
              "connector"
            ],
            "properties": {
              "role": {
                "type": "string"
              },
              "connector": {
                "type": "string"
              },
              "access_managed_in": {
                "const": "panel"
              }
            }
          }
        },
        "gateway": {
          "type": "object",
          "properties": {
            "metering_id": {
              "type": "string",
              "description": "Per-AIOC cost-metering identity on the shared AI gateway."
            }
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "description": "The AIOC's Configuration (49GAION-aioc template §15): 49GAION fixes the path; who holds each role is configured in each organisation. Every slot must be filled; an AIOC with any empty slot does not pass the joining test. Each value records who set it, when and in which version; a changed value is marked replaced_by, never deleted. office_accountable_human: the HOAC seat accountable for OCO, which decides objections held open (Protocol §4.7). central_head: the OCO of this unit's [ORG]AION. budget_cap: the AIOC's cap on AI spend through the shared AI gateway. chain_depth: the maximum depth of Work Item chains, set by the organisation. unattended_action: what a Chief of Staff may do with no human present (Protocol §7).",
      "required": [
        "office_accountable_human",
        "central_head",
        "discussion_limits",
        "waiting_deadlines",
        "bounce_limit",
        "chain_depth",
        "halt_request_priority",
        "budget_cap",
        "unattended_action"
      ],
      "properties": {
        "office_accountable_human": {
          "type": "object",
          "required": [
            "value",
            "set_by",
            "date",
            "version"
          ],
          "properties": {
            "value": {},
            "set_by": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "replaced_by": {
              "type": "string"
            }
          }
        },
        "central_head": {
          "type": "object",
          "required": [
            "value",
            "set_by",
            "date",
            "version"
          ],
          "properties": {
            "value": {},
            "set_by": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "replaced_by": {
              "type": "string"
            }
          }
        },
        "discussion_limits": {
          "type": "object",
          "required": [
            "value",
            "set_by",
            "date",
            "version"
          ],
          "properties": {
            "value": {},
            "set_by": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "replaced_by": {
              "type": "string"
            }
          }
        },
        "waiting_deadlines": {
          "type": "object",
          "required": [
            "value",
            "set_by",
            "date",
            "version"
          ],
          "properties": {
            "value": {},
            "set_by": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "replaced_by": {
              "type": "string"
            }
          }
        },
        "bounce_limit": {
          "type": "object",
          "required": [
            "value",
            "set_by",
            "date",
            "version"
          ],
          "properties": {
            "value": {},
            "set_by": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "replaced_by": {
              "type": "string"
            }
          }
        },
        "chain_depth": {
          "type": "object",
          "required": [
            "value",
            "set_by",
            "date",
            "version"
          ],
          "properties": {
            "value": {},
            "set_by": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "replaced_by": {
              "type": "string"
            }
          }
        },
        "halt_request_priority": {
          "type": "object",
          "required": [
            "value",
            "set_by",
            "date",
            "version"
          ],
          "properties": {
            "value": {},
            "set_by": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "replaced_by": {
              "type": "string"
            }
          }
        },
        "budget_cap": {
          "type": "object",
          "required": [
            "value",
            "set_by",
            "date",
            "version"
          ],
          "properties": {
            "value": {},
            "set_by": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "replaced_by": {
              "type": "string"
            }
          }
        },
        "unattended_action": {
          "type": "string",
          "enum": [
            "read-record-triage",
            "act-within-limits"
          ],
          "description": "What a Chief of Staff may do after an automatic wake-up with no human present (Protocol §7): read-record-triage (the default) or act-within-limits. Set by the accountable human."
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
      "description": "SemVer version of this unit (A2A AgentCard requires a version)."
    },
    "lineage": {
      "type": "object",
      "description": "Where this unit comes from: the unit and version it was derived, merged or split from.",
      "required": [
        "id",
        "version",
        "relation"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "original",
            "derived",
            "merged",
            "split"
          ]
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "description": "What the AIOC can do (A2A AgentSkill alignment).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "tags"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "statuses": {
      "type": "array",
      "description": "Statuses this unit uses; each from the shared list (status.schema.json; Protocol §4.2).",
      "items": {
        "$ref": "status.schema.json"
      }
    },
    "lifecycle_state": {
      "enum": [
        "proposed",
        "designed",
        "built",
        "joined",
        "live",
        "replaced",
        "retired"
      ],
      "description": "Unit lifecycle state."
    }
  },
  "$defs": {
    "workKind": {
      "type": "object",
      "required": [
        "kind",
        "format",
        "acceptance_test"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "A kind of work the AIOC accepts (A2A: skill)."
        },
        "format": {
          "type": "string",
          "description": "The format it must arrive in."
        },
        "acceptance_test": {
          "type": "string",
          "description": "Reference (ID + version) to the fixed test the input socket applies."
        },
        "decision_needed": {
          "type": "boolean",
          "description": "true if this kind always needs a human decision."
        }
      }
    }
  }
}
