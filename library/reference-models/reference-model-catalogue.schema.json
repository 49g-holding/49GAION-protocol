{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/49g-holding/49GAION-protocol/library/reference-models/reference-model-catalogue.schema.json",
  "title": "49GAION Library - reference-model catalogue",
  "description": "The 49GAION reference-model catalogue as [ORG]AIOC-TOM reads it (blueprint Annex E.19). A pattern is a method, never evidence (blueprint Annex B.5).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogue",
    "version",
    "status",
    "rules",
    "patterns"
  ],
  "properties": {
    "catalogue": {
      "const": "49GAION Reference-Model Catalogue"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "released"
      ]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pattern_id",
          "name",
          "summary",
          "typical_capabilities",
          "decision_rights",
          "typical_hand_offs",
          "fits_when",
          "does_not_fit_when",
          "known_risks",
          "never_evidence"
        ],
        "properties": {
          "pattern_id": {
            "type": "string",
            "pattern": "^RMP-[A-Z0-9-]{2,24}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "typical_capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "decision_rights": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decision",
                "role_type"
              ],
              "properties": {
                "decision": {
                  "type": "string",
                  "minLength": 1
                },
                "role_type": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "typical_hand_offs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to",
                "what_crosses"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "what_crosses": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "fits_when": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "does_not_fit_when": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "known_risks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "never_evidence": {
            "const": "This pattern is never evidence for an organisation."
          }
        }
      }
    }
  }
}
